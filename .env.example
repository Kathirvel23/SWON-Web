# ---- application -------------------------------------------------------
APP_NAME="SWON"
APP_ENV=local
APP_URL=http://localhost:8080
APP_KEY=change-me-to-a-long-random-string

# PWA: set false if a local service worker gets in the way of debugging.
PWA_ENABLED=true

# ---- database ----------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=swon_web
DB_USER=root
DB_PASS=

# ---- auth / OTP --------------------------------------------------------
SESSION_NAME=swon_session
# Dev mode shows the OTP on screen instead of sending an SMS.
# MUST be false in production (a real MSG91/SMS integration is required).
OTP_DEV_MODE=true
# OTP is OFF by default in this test build. Set true to require OTP again.
# NEVER leave this false for a public launch.
OTP_ENABLED=false
# How a code reaches the person asking for it:
#   auto   (default) - on screen for numbers in OTP_DEV_PHONES, otherwise written to
#                      storage/logs/otp.log (no SMS provider is wired up yet)
#   screen           - always on screen (same as OTP_DEV_MODE=true)
#   log              - only written to storage/logs/otp.log, never shown
#   sms              - reserved for the MSG91 integration; until then it falls back to the log
# For no-SMS testing only, set `screen`: the code is shown in an in-app
# notification. Never use `screen` for a public launch.
OTP_DELIVERY=auto
# Your own numbers, comma separated. These see the code on screen even when
# OTP_DEV_MODE is false, so you can sign in on the live site without opening
# the door for everyone. Example: OTP_DEV_PHONES=9876543210,9000000001
OTP_DEV_PHONES=
OTP_TTL_SECONDS=120
OTP_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_PER_15MIN=5
